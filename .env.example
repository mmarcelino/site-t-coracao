# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Microsoft Clarity project ID. Leave empty to keep analytics fully off (no script, no errors).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Guesty Booking Engine API (server-only: never prefix with NEXT_PUBLIC_). Leave the dummy values
# to run on local mock data. Real keys only in .env.local / Vercel (Sensitive). See CLAUDE.md §16.
GUESTY_BOOKING_ENGINE_CLIENT_ID=dummy-client-id
GUESTY_BOOKING_ENGINE_CLIENT_SECRET=dummy-client-secret
GUESTY_BOOKING_ENGINE_BASE_URL=https://booking.guesty.com/api

# Map tiles for the apartments map (Leaflet). Default: OpenStreetMap standard tiles (dev only, no key).
# At launch, set a styled provider with a key, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/<style>/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_ATTRIBUTION=
